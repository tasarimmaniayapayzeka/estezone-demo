# Estezone demo — sunucu ayarları (Git deploy ile gelir)
RewriteEngine On

# İçerik pazarlığını (MultiViews) kapat: hem blog.html hem blog/ klasörü
# var; MultiViews açıkken /blog/yazi.html isteği blog.html dosyasına
# eşleşip 500 üretiyordu. Yönlendirmeyi aşağıdaki kural yapar.
Options -MultiViews -Indexes

# /blog ve /blog/ → blog.html. Klasör adı ile sayfa adı çakışıyor;
# bu kural aşağıdaki genel kuraldan ÖNCE gelmeli.
RewriteRule ^blog/?$ /blog.html [R=301,L]

# .html uzantısız adresler de çalışsın (…/iletisim → iletisim.html)
# Üç koruma: dizin isteklerine, var olan dosyalara ve sonu "/" olan
# adreslere dokunma — aksi halde kural kendi çıktısını yeniden yazıp
# döngüye giriyor.
RewriteCond %{REQUEST_URI} !/$
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^(.*)$ /$1.html [L]

ErrorDocument 404 /404.html

# Kaynak/yardımcı dosyalar dışarıya kapalı
<FilesMatch "\.(md|json|log|bak|yml)$">
  Require all denied
</FilesMatch>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType video/mp4 "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType text/html "access plus 10 minutes"
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # Tasarım demosu: arama motorlarına başlık düzeyinde de kapalı
  Header always set X-Robots-Tag "noindex, nofollow"
</IfModule>
